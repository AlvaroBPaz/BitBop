# =============================================================================
# CONFIGURAÇÃO DE INTEGRAÇÕES DO STACK-CHAN DESKTOP COMPANION
# =============================================================================

# 1. GOOGLE AGENDA (CALENDAR)
# URL gerada ao implantar google_calendar_webhook.gs como App da Web no Google Apps Script
GOOGLE_CALENDAR_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec

# 2. GOOGLE KEEP (NOTAS & LISTAS)
# Opção A (Recomendada): Webhook do Google Apps Script (google_keep_webhook.gs ou a mesma URL acima)
GOOGLE_KEEP_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec

# Opção B (Opcional - via biblioteca python gkeepapi):
# Requer: pip install gkeepapi
GOOGLE_KEEP_EMAIL=seu_email@gmail.com
GOOGLE_KEEP_MASTER_TOKEN=oauth2_4/0AY0... (ou Senha de App Google)
